# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# Local dev default (SQLite, zero setup):
DATABASE_URL=sqlite:///./bazaarsync.db
# Production example (Postgres):
# DATABASE_URL=postgresql+psycopg2://bazaarsync:password@localhost:5432/bazaarsync

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- WhatsApp (Twilio Sandbox) ---
WHATSAPP_PROVIDER=twilio
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VALIDATE_SIGNATURE=false

# --- API auth ---
# Leave blank to disable auth locally. Set a strong random value in production.
API_KEY=
